# Public base URL for OAuth redirect construction
# Example (production): https://testas-mock-test.vercel.app
# Example (local): http://localhost:3000
NEXT_PUBLIC_APP_URL=https://mocktest.kni.vn

# Proxied Supabase base URL (recommended for OAuth UX):
# https://<your-domain>/supabase
NEXT_PUBLIC_SUPABASE_PROXY_URL=https://mocktest.kni.vn/supabase

# Server-only. Use an `sb_secret_...` key from Supabase Dashboard > Settings > API Keys.
# Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Feature flags
# Set to 'false' to disable the Subtest Drills feature (defaults to true)
NEXT_PUBLIC_ENABLE_SUBTEST_DRILLS=true

